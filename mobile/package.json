{
  "name": "ascend-level-up",
  "version": "1.0.44",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "doctor": "npx expo-doctor",
    "quality:static": "node scripts/quality_static.js",
    "quality:runtime": "node scripts/runtime_tests.js",
    "export:ios": "npx expo export --platform ios --output-dir dist-ci",
    "audit:critical": "npm audit --omit=dev --audit-level=critical",
    "quality:ci": "npm run quality:static && npm run quality:runtime && npm run doctor && npm run export:ios && npm run audit:critical",
    "build:ios": "eas build --platform ios",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "submit:ios": "eas submit --platform ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-vector-icons/material-icons": "13.1.2",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@supabase/supabase-js": "2.112.3",
    "date-fns": "^2.30.0",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.1",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-sharing": "~57.0.14",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-tracking-transparency": "~57.0.1",
    "i18next": "^23.16.0",
    "react": "19.2.3",
    "react-i18next": "^15.0.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^14.2.2",
    "react-native-purchases": "^8.2.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "babel-preset-expo": "~57.0.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "uuid": "11.1.1"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
